{
  "name": "Nevermore-Fork",
  "globIgnorePaths": [
    "**/.package-lock.json",
    "**/.pnpm",
    "**/.pnpm-workspace-state-v1.json",
    "**/.modules.yaml",
    "**/.ignored",
    "**/.ignored_*",
    "**/catalog.json",
    "**/package.json"
  ],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Packages": {
        "$path": "src/shared"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "ServerPackages": {
        "$path": "src/server"
      }
    }
  }
}
